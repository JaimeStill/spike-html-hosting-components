// The browser tier's in-page module, checked against the declarations this repository's dist/
// ships rather than the sources, which would declare the same custom element twice. The
// foundation's sheets type as its ./css types subpath declares them, as the sources' do.
// support/types.js, which no page runs, holds values typed by those declarations, so one that
// narrows what a consumer may write fails here.
// Adapted from spike-html-apps-components (51d2b92): test/browser/tsconfig.json, its include the
// type guards alone.
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "rootDir": "../.."
  },
  "include": ["support/types.js"]
}
