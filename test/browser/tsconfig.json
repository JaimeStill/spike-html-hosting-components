// The browser tier's type guards, support/types.js, which no page runs: values typed by the
// declarations this repository's dist/ ships rather than the sources, which would declare the same
// custom elements twice, so one that narrows what a consumer may write fails here. The
// foundation's sheets type as its ./css types subpath declares them, as the sources' do.
// Adapted from spike-html-apps-components (51d2b92): test/browser/tsconfig.json, its include the
// type guards alone.
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "rootDir": "../.."
  },
  "include": ["support/types.js"]
}
